///|
test "differential vs qemu-riscv32" {
  for pair in diff_corpus {
    let (hex, expected) = pair
    match run_data(hex_bytes(hex)) {
      Some(r) => assert_eq((r.exit_code & 0xFFL).to_int(), expected)
      None => assert_eq(true, false)
    }
  }
}
